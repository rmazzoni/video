{
  "_meta_note": "FLUX.1-dev text-to-image (best quality, guidance-distilled). Params: @prompt, @seed.",
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" },
    "inputs": { "unet_name": "flux1-dev.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "Load Dual CLIP" },
    "inputs": { "clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp16.safetensors", "type": "flux" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": { "vae_name": "flux-ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": { "text": "@prompt", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "Flux Guidance" },
    "inputs": { "conditioning": ["4", 0], "guidance": "@guidance" }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (Zeroed)" },
    "inputs": { "conditioning": ["4", 0] }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent" },
    "inputs": { "width": "@width", "height": "@height", "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["1", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["9", 0], "filename_prefix": "@filename_prefix" }
  }
}
