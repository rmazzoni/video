{
  "_meta_note": "Z-Image Turbo text-to-image. Expected models: diffusion_models/z_image_turbo_bf16.safetensors, text_encoders/qwen_3_4b.safetensors, vae/ae.safetensors. Params: @prompt, @seed.",
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Z-Image Turbo" },
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Qwen Text Encoder" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": { "text": "@prompt", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (Zeroed)" },
    "inputs": { "conditioning": ["4", 0] }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Empty Latent" },
    "inputs": { "width": "@width", "height": "@height", "batch_size": 1 }
  },
  "7": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Z-Image Sampling Shift" },
    "inputs": { "model": ["1", 0], "shift": 3.0 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["7", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["9", 0], "filename_prefix": "@filename_prefix" }
  }
}
