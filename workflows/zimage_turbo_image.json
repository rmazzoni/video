{
  "1": {
    "_meta": {
      "title": "Load Z-Image Turbo"
    },
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "10": {
    "_meta": {
      "title": "Save Image"
    },
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "@filename_prefix",
      "images": [
        "9",
        0
      ]
    }
  },
  "2": {
    "_meta": {
      "title": "Load Qwen Text Encoder"
    },
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "device": "default",
      "type": "lumina2"
    }
  },
  "3": {
    "_meta": {
      "title": "Load VAE"
    },
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "_meta": {
      "title": "Positive Prompt"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "@prompt"
    }
  },
  "5": {
    "_meta": {
      "title": "Negative (Zeroed)"
    },
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "4",
        0
      ]
    }
  },
  "6": {
    "_meta": {
      "title": "Empty Latent"
    },
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "batch_size": 1,
      "height": "@height",
      "width": "@width"
    }
  },
  "7": {
    "_meta": {
      "title": "Z-Image Sampling Shift"
    },
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": "@shift"
    }
  },
  "8": {
    "_meta": {
      "title": "KSampler"
    },
    "class_type": "KSampler",
    "inputs": {
      "cfg": 1,
      "denoise": 1,
      "latent_image": [
        "6",
        0
      ],
      "model": [
        "7",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "sampler_name": "@sampler",
      "scheduler": "@scheduler",
      "seed": "@seed",
      "steps": "@steps"
    }
  },
  "9": {
    "_meta": {
      "title": "VAE Decode"
    },
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "_meta_note": "Z-Image Turbo text-to-image. Expected models: diffusion_models/z_image_turbo_bf16.safetensors, text_encoders/qwen_3_4b.safetensors, vae/ae.safetensors. Params: @prompt, @seed, @width, @height, @steps, @sampler, @scheduler, @shift, @filename_prefix."
}